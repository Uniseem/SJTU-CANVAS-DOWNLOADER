{
  "name": "sjtu-canvas-downloader",
  "productName": "SJTU Canvas Downloader",
  "version": "2.0.2",
  "description": "上海交通大学 Canvas 课堂录像与课程文件下载器",
  "author": {
    "name": "SJTU Canvas Downloader contributors"
  },
  "homepage": "https://github.com/Uniseem/SJTU-CANVAS-DOWNLOADER",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uniseem/SJTU-CANVAS-DOWNLOADER.git"
  },
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fake": "node scripts/dev-fake.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:engine": "node scripts/build-engine.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && node scripts/package-mac.mjs",
    "test:ui": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}

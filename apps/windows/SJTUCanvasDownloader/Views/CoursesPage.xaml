<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanvasDownloader.Views.CoursesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CanvasDownloader.ViewModels"
    xmlns:helpers="using:CanvasDownloader.Helpers"
    NavigationCacheMode="Required">

    <Grid Padding="36,20,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="课程" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Center"
                PlaceholderText="搜索课程名称、代码或教师"
                QueryIcon="Find"
                AutomationProperties.Name="搜索课程"
                TextChanged="OnSearchChanged" />
            <Button Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新课程" Click="OnRefresh">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </Grid>

        <SelectorBar x:Name="FilterBar" Grid.Row="1" Margin="-12,12,0,8" SelectionChanged="OnFilterChanged">
            <SelectorBarItem x:Name="ActiveFilter" Tag="active" Text="正在修读" IsSelected="True" />
            <SelectorBarItem x:Name="CompletedFilter" Tag="completed" Text="历史课程" />
            <SelectorBarItem x:Name="AllFilter" Tag="all" Text="全部" />
        </SelectorBar>

        <GridView
            x:Name="CourseGrid"
            Grid.Row="2"
            Margin="-4,0,-36,0"
            Padding="0,0,24,24"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnCourseClick">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="4,4,8,8" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:CourseItemViewModel">
                    <Border Width="300" Height="104" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE7BE;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Teacher}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ProgressRing
            Grid.Row="2"
            Width="40"
            Height="40"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind helpers:Format.Show(ViewModel.IsLoading), Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind helpers:Format.Show(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE7BE;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="没有找到课程" />
            <TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Style="{StaticResource SecondaryTextBlockStyle}"
                Text="试试其他筛选条件或搜索词。刚选的课可能需要一段时间才会出现在 Canvas 中。" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            VerticalAlignment="Top"
            Severity="Error"
            Title="无法读取课程列表"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            IsOpen="{x:Bind helpers:Format.HasText(ViewModel.Error), Mode=OneWay}"
            IsClosable="False">
            <InfoBar.ActionButton>
                <Button Content="重试" Click="OnRefresh" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>

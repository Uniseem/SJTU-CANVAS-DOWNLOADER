<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanvasDownloader.Views.CoursePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CanvasDownloader.ViewModels"
    xmlns:helpers="using:CanvasDownloader.Helpers">

    <Page.Resources>
        <Style x:Key="RowListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Page.Resources>

    <Grid Padding="36,20,36,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind ViewModel.Title}"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="True" />
            <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource SecondaryTextBlockStyle}" />
        </StackPanel>

        <!-- Tabs and commands -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="TabBar" Margin="-12,0,0,0" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="LessonsTab" Tag="lessons" Text="课堂录像" IsSelected="True" />
                <SelectorBarItem x:Name="FilesTab" Tag="files" Text="课程文件" />
            </SelectorBar>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="220"
                VerticalAlignment="Center"
                PlaceholderText="搜索录像"
                QueryIcon="Find"
                AutomationProperties.Name="搜索"
                TextChanged="OnSearchChanged" />
            <DropDownButton
                x:Name="TracksButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="选择要下载的画面，每个画面保存为一个视频文件"
                AutomationProperties.Name="下载的画面">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE714;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.TracksText, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <ToggleMenuFlyoutItem x:Name="SlidesToggle" Tag="slides" Text="电脑屏幕" Click="OnTrackToggled" />
                        <ToggleMenuFlyoutItem x:Name="TeacherToggle" Tag="teacher" Text="教室摄像头" Click="OnTrackToggled" />
                        <ToggleMenuFlyoutItem x:Name="CompositeToggle" Tag="composite" Text="合成画面（若课程提供）" Click="OnTrackToggled" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                x:Name="DownloadButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="False"
                Click="OnDownloadSelected">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock x:Name="DownloadButtonText" Text="下载所选" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Messages (collapsed while closed, so they take no space) -->
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="ResultBar" IsClosable="True" IsOpen="False" Visibility="Collapsed" Closed="OnInfoBarClosed">
                <InfoBar.ActionButton>
                    <Button Content="查看下载" Click="OnViewDownloads" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="HistoricalBar"
                Severity="Informational"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed"
                Closed="OnInfoBarClosed"
                Title="已自动使用“课堂视频旧版”" />
            <InfoBar x:Name="LessonsErrorBar" IsClosable="False" IsOpen="False" Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button x:Name="LessonsRetryButton" Content="重试" Click="OnRetryLessons" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="FilesErrorBar" Severity="Error" Title="无法读取课程文件" IsClosable="False" IsOpen="False" Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button Content="重试" Click="OnRetryFiles" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Selection -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllBox" Content="全选" MinWidth="0" Click="OnSelectAll" />
            <TextBlock
                x:Name="SelectionText"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryTextBlockStyle}" />
        </Grid>

        <!-- Lessons -->
        <ListView
            x:Name="LessonList"
            Grid.Row="4"
            Margin="-12,0,-12,0"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind ViewModel.Lessons}"
            SelectionMode="Multiple"
            ItemContainerStyle="{StaticResource RowListViewItemStyle}"
            ContainerContentChanging="OnLessonContainerChanging"
            SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LessonItemViewModel">
                    <Grid MinHeight="60" Padding="0,8" ColumnSpacing="14" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE714;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                MinWidth="72"
                                VerticalAlignment="Center"
                                TextAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SizeText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind SizeTooltip, Mode=OneWay}" />
                            <HyperlinkButton
                                Padding="4,2"
                                Content="重试"
                                Tag="{x:Bind}"
                                Click="OnRetrySize"
                                AutomationProperties.Name="重新获取大小"
                                Visibility="{x:Bind helpers:Format.Show(CanRetrySize), Mode=OneWay}" />
                            <Border Style="{StaticResource TagBorderStyle}" Visibility="{x:Bind helpers:Format.Show(Unavailable)}">
                                <TextBlock Text="未开放或处理中" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            Click="OnDownloadLesson"
                            ToolTipService.ToolTip="下载这一讲"
                            AutomationProperties.Name="{x:Bind DownloadLabel}"
                            Visibility="{x:Bind helpers:Format.Show(Available)}">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Files -->
        <ListView
            x:Name="FileList"
            Grid.Row="4"
            Margin="-12,0,-12,0"
            Padding="0,0,0,24"
            Visibility="Collapsed"
            ItemsSource="{x:Bind ViewModel.Files}"
            SelectionMode="Multiple"
            ItemContainerStyle="{StaticResource RowListViewItemStyle}"
            SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                    <Grid MinHeight="56" Padding="0,8" ColumnSpacing="14" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind SizeText}" />
                        <Button
                            Grid.Column="3"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            Click="OnDownloadFile"
                            ToolTipService.ToolTip="下载这个文件"
                            AutomationProperties.Name="{x:Bind DownloadLabel}">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing x:Name="LoadingRing" Grid.Row="4" Width="40" Height="40" VerticalAlignment="Top" Margin="0,48,0,0" />

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="4"
            MaxWidth="440"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon x:Name="EmptyGlyph" Glyph="&#xE714;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyDetail" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>

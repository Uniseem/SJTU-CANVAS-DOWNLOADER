<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanvasDownloader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CanvasDownloader.Controls"
    xmlns:helpers="using:CanvasDownloader.Helpers">

    <ScrollViewer x:Name="ScrollHost" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- A viewport-wide wrapper keeps the max-width column centred. -->
        <Grid MinWidth="{x:Bind ScrollHost.ViewportWidth, Mode=OneWay}">
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Stretch"
                Spacing="4">
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

                <InfoBar
                    Severity="Warning"
                    IsClosable="False"
                    Title="演示模式"
                    Message="SJTU_CANVAS_FAKE_SCHOOL=1：课程、录像和文件都是演示数据，不会连接学校服务。"
                    IsOpen="{x:Bind ViewModel.IsDemo, Mode=OneWay}" />
                <InfoBar
                    Severity="Error"
                    IsClosable="True"
                    Title="设置未能保存"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    IsOpen="{x:Bind helpers:Format.HasText(ViewModel.Error), Mode=OneWay}" />

                <!-- Account -->
                <TextBlock Text="账户" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <controls:SettingsCard Glyph="&#xE77B;" Header="{x:Bind ViewModel.AccountName, Mode=OneWay}" Description="{x:Bind ViewModel.AccountDetail, Mode=OneWay}">
                    <Button Content="退出登录" Click="OnSignOut" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsSignedIn), Mode=OneWay}" />
                </controls:SettingsCard>

                <!-- Downloads -->
                <TextBlock Text="下载" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <controls:SettingsCard Glyph="&#xE8B7;" Header="保存位置" Description="{x:Bind ViewModel.DownloadDir, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="恢复默认" Click="OnResetFolder" Visibility="{x:Bind helpers:Format.Hide(ViewModel.IsDefaultDownloadDir), Mode=OneWay}" />
                        <Button Content="打开" Click="OnOpenFolder" />
                        <Button Content="更改…" Click="OnChangeFolder" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Glyph="&#xE8DA;" Header="每次下载前选择保存位置" Description="开启后，每次下载都会先询问保存到哪个文件夹。课程、录像按课程和讲次自动分文件夹保存。">
                    <ToggleSwitch
                        MinWidth="0"
                        OnContent="开"
                        OffContent="关"
                        AutomationProperties.Name="每次下载前选择保存位置"
                        IsOn="{x:Bind ViewModel.AskDestination, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Glyph="&#xE9D9;" Header="同时下载的文件数" Description="同时下载更多文件会占用更多带宽；学校服务繁忙时建议 2–3 个。">
                    <NumberBox
                        MinWidth="120"
                        Minimum="1"
                        Maximum="{x:Bind ViewModel.ConcurrencyMax, Mode=OneWay}"
                        SpinButtonPlacementMode="Compact"
                        AutomationProperties.Name="同时下载的文件数"
                        Value="{x:Bind ViewModel.Concurrency, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Glyph="&#xE714;" Header="默认下载的画面" Description="打开课程时预先选中的录像画面，每个画面保存为一个独立的视频文件。">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="电脑屏幕" MinWidth="0" IsChecked="{x:Bind ViewModel.Slides, Mode=TwoWay}" />
                        <CheckBox Content="教室摄像头" MinWidth="0" IsChecked="{x:Bind ViewModel.Teacher, Mode=TwoWay}" />
                        <CheckBox Content="合成画面" MinWidth="0" IsChecked="{x:Bind ViewModel.Composite, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Network -->
                <TextBlock Text="网络" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <controls:SettingsCard Glyph="&#xE774;" Header="代理" Description="访问 Canvas 和课堂视频时使用的代理。开启了全局代理而学校网站打不开时，选择“不使用代理”。交我办扫码连接始终直接连接。">
                    <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.ProxyModeIndex, Mode=TwoWay}" AutomationProperties.Name="代理">
                        <x:String>跟随系统</x:String>
                        <x:String>不使用代理</x:String>
                        <x:String>自定义</x:String>
                    </ComboBox>
                </controls:SettingsCard>
                <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind helpers:Format.Show(ViewModel.IsCustomProxy), Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="代理地址"
                            PlaceholderText="http://127.0.0.1:7890 或 socks5://127.0.0.1:1080"
                            Text="{x:Bind ViewModel.ProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Content="保存" Click="OnSaveProxy" />
                    </Grid>
                </Border>

                <!-- About -->
                <TextBlock Text="关于" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <controls:SettingsCard Glyph="&#xE946;" Header="SJTU Canvas Downloader" Description="{x:Bind ViewModel.VersionText, Mode=OneWay}">
                    <HyperlinkButton Content="源代码与说明" NavigateUri="https://github.com/Uniseem/SJTU-CANVAS-DOWNLOADER" />
                </controls:SettingsCard>
                <controls:SettingsCard Glyph="&#xE8F1;" Header="数据与日志" Description="{x:Bind ViewModel.DataDir, Mode=OneWay}">
                    <Button Content="打开" Click="OnOpenData" />
                </controls:SettingsCard>
                <TextBlock
                    Margin="1,12,0,0"
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    Text="本应用与上海交通大学、Instructure 和 jAccount 均无隶属或合作关系。请只下载你有权访问的课程资料，并遵守学校和课程的相关规定。" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

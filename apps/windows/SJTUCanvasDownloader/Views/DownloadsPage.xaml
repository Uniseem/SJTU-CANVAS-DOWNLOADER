<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanvasDownloader.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CanvasDownloader.ViewModels"
    xmlns:helpers="using:CanvasDownloader.Helpers"
    NavigationCacheMode="Required">

    <Grid Padding="36,20,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="下载" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" OverflowButtonVisibility="Auto">
                <AppBarButton Label="全部暂停" Click="OnPauseAll" IsEnabled="{x:Bind CanPauseAll(ViewModel.Counts), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE769;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="全部继续" Click="OnResumeAll" IsEnabled="{x:Bind CanResumeAll(ViewModel.Counts), Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="打开下载文件夹" Click="OnOpenFolder">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="清除已完成的任务" Click="OnClearCompleted" IsEnabled="{x:Bind CanClear(ViewModel.Counts), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <SelectorBar x:Name="FilterBar" Grid.Row="1" Margin="-12,8,0,8" SelectionChanged="OnFilterChanged">
            <SelectorBarItem x:Name="AllFilter" Tag="all" Text="全部" IsSelected="True" />
            <SelectorBarItem x:Name="ActiveFilter" Tag="active" Text="进行中" />
            <SelectorBarItem x:Name="CompletedFilter" Tag="completed" Text="已完成" />
            <SelectorBarItem x:Name="FailedFilter" Tag="failed" Text="失败与取消" />
        </SelectorBar>

        <ListView
            x:Name="DownloadList"
            Grid.Row="2"
            Margin="-12,0,-12,0"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                    <Grid MinHeight="72" Padding="0,10" ColumnSpacing="14" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="打开" Tag="{x:Bind}" Click="OnOpen" IsEnabled="{x:Bind IsCompleted, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="在文件资源管理器中显示" Tag="{x:Bind}" Click="OnReveal">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="暂停" Tag="{x:Bind}" Click="OnPause" IsEnabled="{x:Bind CanPause, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="继续" Tag="{x:Bind}" Click="OnResume" IsEnabled="{x:Bind CanResume, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="重新下载" Tag="{x:Bind}" Click="OnRetry" IsEnabled="{x:Bind CanRetry, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="取消下载" Tag="{x:Bind}" Click="OnCancel" IsEnabled="{x:Bind CanCancel, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="从列表中移除" Tag="{x:Bind}" Click="OnRemove" IsEnabled="{x:Bind CanRemove, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40"
                            Height="40"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                Margin="0,4,0,2"
                                Maximum="100"
                                Value="{x:Bind Progress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                ShowPaused="{x:Bind ShowPaused, Mode=OneWay}"
                                ShowError="{x:Bind ShowError, Mode=OneWay}"
                                Visibility="{x:Bind helpers:Format.Show(ShowProgress), Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC61;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind helpers:Format.Show(IsCompleted), Mode=OneWay}" />
                                <FontIcon Glyph="&#xEB90;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind helpers:Format.Show(IsFailed), Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnPause" ToolTipService.ToolTip="暂停" AutomationProperties.Name="暂停" Visibility="{x:Bind helpers:Format.Show(CanPause), Mode=OneWay}">
                                <FontIcon Glyph="&#xE769;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnResume" ToolTipService.ToolTip="继续" AutomationProperties.Name="继续" Visibility="{x:Bind helpers:Format.Show(CanResume), Mode=OneWay}">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnRetry" ToolTipService.ToolTip="重新下载" AutomationProperties.Name="重新下载" Visibility="{x:Bind helpers:Format.Show(CanRetry), Mode=OneWay}">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnOpen" ToolTipService.ToolTip="打开" AutomationProperties.Name="打开" Visibility="{x:Bind helpers:Format.Show(IsCompleted), Mode=OneWay}">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnReveal" ToolTipService.ToolTip="在文件资源管理器中显示" AutomationProperties.Name="在文件资源管理器中显示">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind}" Click="OnCancel" ToolTipService.ToolTip="取消下载" AutomationProperties.Name="取消下载" Visibility="{x:Bind helpers:Format.Show(CanCancel), Mode=OneWay}">
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind helpers:Format.Show(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE896;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind EmptyTitle(ViewModel.Filter), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Style="{StaticResource SecondaryTextBlockStyle}"
                Text="在课程中选择课堂录像或课程文件，点“下载”后会出现在这里。" />
            <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="浏览课程" Click="OnBrowseCourses" />
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            VerticalAlignment="Top"
            Severity="Error"
            Title="无法读取下载列表"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            IsOpen="{x:Bind helpers:Format.HasText(ViewModel.Error), Mode=OneWay}"
            IsClosable="False" />
    </Grid>
</Page>

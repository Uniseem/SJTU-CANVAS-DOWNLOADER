<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CanvasDownloader.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CanvasDownloader.Helpers">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="440"
            Padding="24,32,24,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <Image
                Width="56"
                Height="56"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.png"
                AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="登录 Canvas" />
                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="用“交我办”扫描二维码，并在手机上确认登录。" />
            </StackPanel>

            <!-- A QR code must stay dark-on-white to scan, whatever the theme. -->
            <Border
                Width="264"
                Height="264"
                HorizontalAlignment="Center"
                Padding="12"
                Background="White"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <Image
                        Source="{x:Bind ViewModel.QrImage, Mode=OneWay}"
                        Stretch="Uniform"
                        AutomationProperties.Name="交我办登录二维码" />
                    <ProgressRing
                        Width="48"
                        Height="48"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.Show(ViewModel.IsBusy), Mode=OneWay}" />
                    <Grid
                        Margin="-12"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="#E6FFFFFF"
                        Visibility="{x:Bind helpers:Format.Show(ViewModel.IsExpired), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <TextBlock HorizontalAlignment="Center" Foreground="Black" Style="{StaticResource BodyStrongTextBlockStyle}" Text="二维码已过期" />
                            <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="刷新二维码" Click="OnRefresh" />
                        </StackPanel>
                    </Grid>
                    <FontIcon
                        FontSize="48"
                        Foreground="#8A8A8A"
                        Glyph="&#xE783;"
                        Visibility="{x:Bind helpers:Format.Show(ViewModel.IsFailed), Mode=OneWay}" />
                    <FontIcon
                        FontSize="48"
                        Foreground="#0F7B0F"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind helpers:Format.Show(ViewModel.IsDone), Mode=OneWay}" />
                </Grid>
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}" />

            <Button
                HorizontalAlignment="Center"
                Content="刷新二维码"
                Click="OnRefresh"
                IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsBusy), Mode=OneWay}"
                Style="{x:Bind RefreshStyle(ViewModel.IsFailed), Mode=OneWay}" />

            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Style="{StaticResource SecondaryTextBlockStyle}"
                Text="扫码确认后会自动继续。本应用不会读取、输入或保存你的 jAccount 密码和短信验证码。" />
            <HyperlinkButton HorizontalAlignment="Center" Content="网络与代理设置" Click="OnOpenSettings" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CanvasDownloader.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CanvasDownloader.Helpers"
    HorizontalAlignment="Stretch">
    <Border Style="{StaticResource CardBorderStyle}" MinHeight="68" Padding="16,12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Glyph="{x:Bind Glyph, Mode=OneWay}"
                FontSize="20"
                VerticalAlignment="Center"
                Visibility="{x:Bind helpers:Format.ShowText(Glyph), Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind Description, Mode=OneWay}"
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    Visibility="{x:Bind helpers:Format.ShowText(Description), Mode=OneWay}" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>

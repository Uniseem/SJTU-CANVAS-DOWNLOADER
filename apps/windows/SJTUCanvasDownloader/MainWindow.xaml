<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CanvasDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SJTU Canvas Downloader">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The height matches the tall caption buttons whichever buttons are shown. -->
        <TitleBar
            x:Name="AppTitleBar"
            Height="48"
            Title="SJTU Canvas Downloader"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            IsPaneVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CoursesItem" Content="课程" Tag="courses">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DownloadsItem" Content="下载" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="RunningBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- The signed-in account: a flyout with its name and the sign-out command. -->
                <NavigationViewItem x:Name="AccountItem" Tag="account" SelectsOnInvoked="False" Content="账户">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="RightEdgeAlignedBottom">
                            <StackPanel MinWidth="240" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PersonPicture x:Name="AccountPicture" Width="44" Height="44" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="AccountNameText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="AccountIdText" Style="{StaticResource SecondaryTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Stretch" Content="退出登录" Click="OnSignOut" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    x:Name="EngineInfoBar"
                    Margin="24,12,24,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="EngineRetryButton" Content="重新启动引擎" Click="OnRestartEngine" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="OnNavigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>

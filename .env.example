# 对外域名，不含路径。生产环境应使用 HTTPS。
DOMAIN=canvas.example.com
PUBLIC_URL=https://canvas.example.com

# 至少 32 字节随机值：openssl rand -base64 48
APP_SECRET=

# 可选调节项
RUST_LOG=canvas_pocket_server=info,tower_http=info
SESSION_TTL_DAYS=7
DOWNLOAD_TICKET_TTL_MINUTES=15
PROXY_CONCURRENCY=8

# 课堂视频：自动根据 Canvas 的授权表单选择协议，旧接口保留兼容。
VIDEO_API=https://v.sjtu.edu.cn/jy-application-canvas-sjtu
VIDEO_LTI_ADAPTER=https://v.sjtu.edu.cn/jy-lti-adapter
RESOURCE_VIDEO_API=https://v.sjtu.edu.cn/jy-application-resourcemanage
